  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-production.mjs",
    "verify:production": "node scripts/verify-production-export.mjs out",
    "preview": "npm run verify:production && npx serve out",
    "lint": "eslint .",
